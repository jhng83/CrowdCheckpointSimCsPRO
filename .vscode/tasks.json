{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/CrowdCheckpointSim.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/tests/CrowdCheckpointSim.Tests/CrowdCheckpointSim.Tests.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/CrowdCheckpointSim.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}
